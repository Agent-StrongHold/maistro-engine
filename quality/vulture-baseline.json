{
  "version": 1,
  "owner": "@BlakeMatthews-dev",
  "policy": "Classify current vulture findings by runtime discovery mechanism or declarative framework surface. New unreachable-code findings are never allowlisted and must be fixed.",
  "rules": [
    {
      "id": "fastapi-route-handler",
      "category": "framework_decorator_surface",
      "owner": "@BlakeMatthews-dev",
      "path_regex": "packages/.*/(routes|api|main)\\.py|packages/.*/(routes|api)/.*\\.py",
      "message_regex": "unused function",
      "rationale": "FastAPI route decorators register these callables dynamically; static import scanning cannot see decorator-based dispatch."
    },
    {
      "id": "pydantic-declarative-field",
      "category": "declarative_model_field",
      "owner": "@BlakeMatthews-dev",
      "message_regex": "unused (variable|attribute) '",
      "source_contains_any": [
        "BaseModel",
        "pydantic",
        "Field(",
        "ConfigDict",
        "StrEnum",
        "Enum"
      ],
      "rationale": "Pydantic models and enums expose fields declaratively for validation/serialization rather than direct Python reads."
    },
    {
      "id": "dataclass-declarative-field",
      "category": "declarative_model_field",
      "owner": "@BlakeMatthews-dev",
      "message_regex": "unused (variable|attribute) '",
      "source_contains_any": [
        "@dataclass",
        "dataclass(",
        "TypedDict",
        "NamedTuple"
      ],
      "rationale": "Dataclass/typed record fields are constructed and serialized by convention or reflection, not always read directly in package-local code."
    },
    {
      "id": "fastapi-app-state",
      "category": "framework_decorator_surface",
      "owner": "@BlakeMatthews-dev",
      "path_regex": "packages/maistro-server/src/maistro_server/main\\.py|packages/hive-conductor/backend/main\\.py",
      "message_regex": "unused attribute",
      "source_contains_any": [
        "app.state"
      ],
      "rationale": "FastAPI/Starlette app.state attributes are dynamic framework state consumed through the application object."
    },
    {
      "id": "hive-service-api-surface",
      "category": "dynamic_import_surface",
      "owner": "@BlakeMatthews-dev",
      "path_regex": "packages/hive-conductor/backend/services/.*\\.py|packages/hive-conductor/cage/.*\\.py",
      "message_regex": "unused (function|class|method|variable|attribute)",
      "rationale": "Hive services are invoked from routes, websocket handlers, chat/tool dispatch, and operational scripts; this category preserves service APIs pending narrower per-service baselines."
    },
    {
      "id": "maistro-cli-command-surface",
      "category": "dynamic_import_surface",
      "owner": "@BlakeMatthews-dev",
      "path_regex": "packages/maistro-core/src/maistro/cli/.*\\.py",
      "message_regex": "unused function",
      "rationale": "CLI subcommands are invoked through argparse dispatch and command wiring rather than direct function imports."
    },
    {
      "id": "bootstrap-builder-surface",
      "category": "planned_implementation_surface",
      "owner": "@BlakeMatthews-dev",
      "path_regex": "packages/maistro-bootstrap/src/maistro_bootstrap/(builders|plan|resolver|schema).*\\.py",
      "message_regex": "unused (function|variable|attribute)",
      "rationale": "Bootstrap builder/resolver outputs are public plan fields or feature-slice hooks used by generated plans and product scaffolding."
    },
    {
      "id": "core-public-api-surface",
      "category": "public_extension_point",
      "owner": "@BlakeMatthews-dev",
      "path_regex": "packages/maistro-core/src/maistro/.*\\.py",
      "message_regex": "unused (function|class|method|variable|attribute)",
      "rationale": "maistro-core exports package APIs consumed by downstream products and sibling repos, so package-local vulture cannot distinguish all public consumers."
    },
    {
      "id": "pytest-discovered-test-surface",
      "category": "test_discovery_surface",
      "owner": "@BlakeMatthews-dev",
      "path_regex": ".*/tests?/.*\\.py|tests/.*\\.py",
      "message_regex": "unused (function|class|method|variable|attribute)",
      "rationale": "Pytest discovers test functions, fixtures, and helper classes by naming and fixture injection."
    },
    {
      "id": "protocol-and-adapter-port",
      "category": "public_extension_point",
      "owner": "@BlakeMatthews-dev",
      "message_regex": "unused (class|method|property)",
      "source_contains_any": [
        "Protocol",
        "ABC",
        "@abstractmethod",
        "__all__",
        "adapter",
        "port"
      ],
      "rationale": "Ports and protocol members define supported extension contracts even when concrete use is indirect."
    },
    {
      "id": "runtime-plugin-entrypoint",
      "category": "dynamic_import_surface",
      "owner": "@BlakeMatthews-dev",
      "message_regex": "unused (function|class|method) '",
      "source_contains_any": [
        "entrypoint",
        "entry point",
        "plugin",
        "registry",
        "register_",
        "__getattr__"
      ],
      "rationale": "Plugin, registry, and lazy-import entrypoints are intentionally discovered by string/name lookup."
    },
    {
      "id": "schema-enum-member",
      "category": "declarative_model_field",
      "owner": "@BlakeMatthews-dev",
      "message_regex": "unused variable '[A-Z][A-Z0-9_]*'",
      "rationale": "Enum members are serialized values and may not appear as direct reads in package-local static analysis."
    },
    {
      "id": "planned-package-api",
      "category": "planned_implementation_surface",
      "owner": "@BlakeMatthews-dev",
      "path_regex": "packages/maistro-(turing|evolve|rsi|canvas|design)/.*\\.py",
      "message_regex": "unused (function|class|method|variable|attribute)",
      "rationale": "Experimental and product-adjacent package APIs are retained as planned implementation surfaces pending per-package hardening specs."
    },
    {
      "id": "tool-or-cli-entrypoint",
      "category": "dynamic_import_surface",
      "owner": "@BlakeMatthews-dev",
      "message_regex": "unused function '(_?tool_|cmd_|run_|execute_|handle_|stream_|list_|get_|create_|update_|delete_|cancel_)",
      "rationale": "Tool, CLI, route, and handler entrypoints are frequently invoked by dispatch tables, CLIs, frameworks, or external clients."
    }
  ]
}
