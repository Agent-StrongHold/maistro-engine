---
import "../styles/global.css";

interface Props {
  title: string;
  active?: string;
}
const { title, active } = Astro.props;

const nav = [
  { href: "/", label: "dashboard", id: "dashboard" },
  { href: "/feed", label: "feed", id: "feed" },
  { href: "/chat", label: "chat", id: "chat" },
  { href: "/admin", label: "admin", id: "admin" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · turing</title>
  </head>
  <body>
    <div class="layout">
      <aside class="sidebar">
        <div class="brand">turing</div>
        <div class="brand-sub">autonoetic self-model</div>
        <nav class="nav">
          {
            nav.map((n) => (
              <a href={n.href} class={active === n.id ? "active" : ""}>
                {n.label}
              </a>
            ))
          }
        </nav>
      </aside>
      <main class="main">
        <slot />
      </main>
    </div>
  </body>
</html>
