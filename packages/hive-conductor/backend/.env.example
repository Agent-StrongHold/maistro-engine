# Copy to `.env` next to this file (backend/) for local runs.
# Never commit real keys.

# --- LiteLLM (OpenAI-compatible API only; must end with /v1) ---
# Hostname: use the **gateway** API host, not the *-admin* UI host.
# Example: https://your-litellm-host.example.com/v1
LITELLM_API_BASE=
LITELLM_API_KEY=

# Default model alias as registered on the LiteLLM proxy (virtual keys / team policy apply server-side).
CHAT_DEFAULT_MODEL=gpt-4o

# --- LLM HTTP protocol (OpenAI-compatible gateway) ---
# auto = try POST …/v1/responses then fall back to …/v1/chat/completions
# responses | chat_completions = force one path
LLM_HTTP_VARIANT=auto

# --- Langfuse 3.x (optional; Python SDK 3.9+ expects self-hosted platform >= 3.125) ---
# --- Tracing via OTEL → Langfuse (optional) ---
# Start Langfuse: docker compose -f docker-compose.tools-lab.yml --profile langfuse up -d
# Then set these to export traces:
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:3100/api/public/otel
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic cGstbGYtamVkYWktZGV2OnNrLWxmLWplZGFpLWRldg==
# ^ base64("pk-lf-jedai-dev:sk-lf-jedai-dev") — matches docker-compose.tools-lab.yml init keys

# --- Conductor Foundation (vault, state, privilege, reactor) ---
# Data directory for all conductor state (default: ~/.conductor)
CONDUCTOR_DATA_DIR=~/.conductor
# Vault: age-encrypted secrets file and admin identity key
CONDUCTOR_VAULT_PATH=
CONDUCTOR_IDENTITY_PATH=
# State: SQLite database path (default: <data_dir>/state.db)
CONDUCTOR_STATE_DB=
# Privilege: admin and user public keys for two-tier auth
CONDUCTOR_ADMIN_PUBLIC_KEY=
CONDUCTOR_USER_PUBLIC_KEY=

# --- Hardware preset ---
# Controls resource limits, worker pool size, queue depth, etc.
# Options: potato | laptop | desktop | beast
HARDWARE_PRESET=laptop
