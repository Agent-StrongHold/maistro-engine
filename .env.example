# ─── Database ─────────────────────────────────────
DB_PASSWORD=changeme-postgres-password

# ─── LLM API Keys ────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=

# ─── LiteLLM ─────────────────────────────────────
LITELLM_MASTER_KEY=sk-litellm-changeme

# ─── Maistro API Auth ────────────────────────────
# Comma-separated list of valid API bearer tokens
# Leave empty for dev mode (no auth required)
API_KEYS=

# ─── Default Model ───────────────────────────────
DEFAULT_MODEL=anthropic/claude-sonnet-4-20250514

# ─── Langfuse ────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_SECRET=changeme-langfuse-secret
LANGFUSE_SALT=changeme-langfuse-salt

# ─── Keycloak (for Open WebUI OIDC) ─────────────
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_OIDC_URL=
